apiVersion: v1
clusters:
- cluster:
    proxy-url: socks5://localhost:1080
    server: https://api.stxt-int-1.74l5.p3.openshiftapps.com:443
  name: stxt-int-1
contexts:
- context:
    cluster: stxt-int-1
    namespace: default
    user: openshift-login
  name: stxt-int-1
current-context: stxt-int-1
kind: Config
users:
- name: openshift-login
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      args: null
      command: openshift-login
      env:
      - name: OPENSHIFT_LOGIN_LOGLEVEL
        value: warn
      - name: HTTPS_PROXY
        value: socks5://localhost:1080
      - name: HTTP_PROXY
        value: socks5://localhost:1080
      - name: https_proxy
        value: socks5://localhost:1080
      - name: http_proxy
        value: socks5://localhost:1080
      interactiveMode: IfAvailable
      provideClusterInfo: true
